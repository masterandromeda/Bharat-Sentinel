# ============================================================
# BharatSentinel — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── AI / LLM ─────────────────────────────────────────────────
# Option A: Azure OpenAI
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4

# Option B: OpenAI (used if Azure vars are not set)
OPENAI_API_KEY=your_openai_api_key_here

# ── Notion ────────────────────────────────────────────────────
# Create a Notion integration at https://www.notion.so/my-integrations
# Share your database with the integration
NOTION_API_KEY=secret_your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id_here

# ── Auth ──────────────────────────────────────────────────────
# Secret key for signing JWT tokens. Use a long random string in production.
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
# Token expiry in minutes (default: 1440 = 24h)
JWT_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────
# SQLite path (relative to working directory or absolute)
DB_PATH=bharat_sentinel.db

# ── Frontend (Next.js) ────────────────────────────────────────
# URL of the backend API server.
# Local dev: leave as default (http://localhost:8081)
# Vercel / production: set to your deployed backend URL (no trailing slash)
#   e.g. https://bharat-sentinel-backend.onrender.com
#        https://your-app.zop.dev
BACKEND_URL=http://localhost:8081

# WebSocket URL for real-time events (browser-side, must be ws:// or wss://)
# Local dev: leave blank (auto-derived as ws://localhost:8081/ws/events)
# Vercel / production: set to wss://your-backend-domain/ws/events
NEXT_PUBLIC_WS_URL=
